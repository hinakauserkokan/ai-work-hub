@page "/"
@using AiWorkHub.Models
@using AiWorkHub.Services
@inject ProjectService ProjectService
@inject WorkItemService WorkItemService

<PageTitle>Dashboard · AI Work Hub</PageTitle>

<div class="page-heading"><div><p class="eyebrow">@DateTime.Now.ToString("dddd, d MMMM").ToUpperInvariant()</p><h1>Good morning, Hina <span aria-hidden="true">👋</span></h1><p class="page-subtitle">Here is what needs your attention today.</p></div><button class="primary-button"><span>＋</span> New task</button></div>

<section class="summary-grid" aria-label="Work summary">
    <article class="summary-card accent-purple"><div class="card-icon">✓</div><div><p>My open tasks</p><strong>@OpenTaskCount</strong><span class="trend">Across all projects</span></div></article>
    <article class="summary-card accent-blue"><div class="card-icon">◉</div><div><p>In progress</p><strong>@InProgressCount</strong><span class="trend">Across @InProgressProjectCount project@(InProgressProjectCount == 1 ? "" : "s")</span></div></article>
    <article class="summary-card accent-amber"><div class="card-icon">◷</div><div><p>Due this week</p><strong>@DueThisWeekCount</strong><span class="trend @(NeedsAttentionCount > 0 ? "warning" : "positive")">@(NeedsAttentionCount > 0 ? $"{NeedsAttentionCount} needs attention" : "All clear")</span></div></article>
</section>

<section class="content-grid">
    <article class="panel task-panel"><div class="panel-heading"><div><h2>My priorities</h2><p>Focus on these next.</p></div><a href="/my-tasks">View all <span>→</span></a></div><div class="task-list">@foreach (var task in PriorityTasks) { <div class="task-row"><button class="check-button" aria-label="Mark @task.Title as complete"></button><div class="task-copy"><strong>@task.Title</strong><span>@task.ProjectName</span></div><span class="priority @task.Priority.CssClass()">@task.Priority.DisplayText()</span><span class="due-date @task.DueClass">@task.Due</span><div class="avatar small">@task.Member.Initials</div></div> }</div></article>
    <article class="panel progress-panel"><div class="panel-heading"><div><h2>Project progress</h2><p>Work moving this week.</p></div><a href="/projects">All projects <span>→</span></a></div>@foreach (var project in TopProjects) { <div class="project-progress"><div><strong>@project.Name</strong><span>@project.Completed / @project.Total tasks</span></div><strong>@project.Percent%</strong></div><div class="progress-track"><span style="width: @project.Percent%"></span></div> }</article>
</section>

<section class="bottom-grid"><article class="panel activity-panel"><div class="panel-heading"><div><h2>Recent activity</h2><p>Updates from your workspace.</p></div></div><div class="activity-item"><div class="avatar small purple">JS</div><p><strong>Jordan Smith</strong> moved <b>Mobile app wireframes</b> to In review.<span>18 minutes ago</span></p></div><div class="activity-item"><div class="avatar small orange">KL</div><p><strong>Kai Lee</strong> added 3 tasks to <b>Website redesign</b>.<span>1 hour ago</span></p></div><div class="activity-item"><div class="avatar small green">MB</div><p><strong>Mina Bose</strong> completed <b>Prepare customer interview</b>.<span>3 hours ago</span></p></div></article><article class="ai-card"><span class="ai-sparkle">✦</span><p class="eyebrow">AI WORKSPACE</p><h2>Turn meeting notes into action.</h2><p>Summarise decisions, identify risks, and suggest tasks for your team to review.</p><button class="secondary-button">Try meeting assistant <span>→</span></button></article></section>

@code {
    // Recent activity and the AI workspace card stay static until the Collaboration and
    // AI-assistant milestones add the data behind them.
    private List<ProjectSummary>? projectSummaries;
    private List<WorkItemSummary>? workItemSummaries;
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    protected override async Task OnInitializedAsync()
    {
        projectSummaries = await ProjectService.GetProjectSummariesAsync();
        workItemSummaries = await WorkItemService.GetWorkItemSummariesAsync();
    }

    private IEnumerable<WorkItemSummary> PriorityTasks => (workItemSummaries ?? [])
        .Where(task => task.Status != WorkItemStatus.InReview)
        .OrderByDescending(task => task.Priority)
        .ThenBy(task => task.DueDate ?? DateOnly.MaxValue)
        .Take(3);

    private IEnumerable<ProjectSummary> TopProjects => (projectSummaries ?? []).Take(3);

    private int OpenTaskCount => (workItemSummaries ?? []).Count(task => task.Status != WorkItemStatus.InReview);
    private int InProgressCount => (workItemSummaries ?? []).Count(task => task.Status == WorkItemStatus.InProgress);
    private int InProgressProjectCount => (workItemSummaries ?? [])
        .Where(task => task.Status == WorkItemStatus.InProgress)
        .Select(task => task.ProjectName)
        .Distinct()
        .Count();
    private int DueThisWeekCount => (workItemSummaries ?? []).Count(task => task.DueDate is { } due && due >= Today && due <= Today.AddDays(7));
    private int NeedsAttentionCount => (workItemSummaries ?? []).Count(task => task.DueDate is { } due && due <= Today);
}
