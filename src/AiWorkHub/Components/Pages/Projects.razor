@page "/projects"
@using AiWorkHub.Services
@inject ProjectService ProjectService

<PageTitle>Projects · AI Work Hub</PageTitle>

<div class="page-heading">
    <div><p class="eyebrow">WORKSPACE</p><h1>Projects</h1><p class="page-subtitle">Keep every piece of work moving in the right direction.</p></div>
    <button class="primary-button" @onclick="AddProject"><span>＋</span> New project</button>
</div>

<section class="project-toolbar" aria-label="Project filters">
    <div class="filter-tabs" role="tablist">@foreach (var filter in Filters) { <button class="filter-tab @(activeFilter == filter ? "active" : null)" @onclick="() => activeFilter = filter">@filter</button> }</div>
    <label class="list-search"><span aria-hidden="true">⌕</span><input @bind="searchTerm" placeholder="Search projects" aria-label="Search projects" /></label>
</section>

@if (projects is null)
{
    <p class="empty-column">Loading projects…</p>
}
else
{
    <section class="project-grid" aria-label="Projects">
        @foreach (var project in VisibleProjects)
        {
            <article class="project-card">
                <div class="project-card-top"><span class="project-icon @project.Accent">@project.Icon</span><button class="quiet-button" aria-label="More options for @project.Name">•••</button></div>
                <h2>@project.Name</h2><p>@project.Description</p>
                <div class="project-meta"><span class="status-pill @project.StatusClass">@project.Status</span><span>@project.DueText</span></div>
                <div class="project-card-progress"><div><span>@project.Completed of @project.Total tasks</span><strong>@project.Percent%</strong></div><div class="progress-track"><span style="width: @project.Percent%"></span></div></div>
                <div class="project-card-footer"><div class="avatar-stack" aria-label="Project team">@foreach (var member in project.Members) { <span class="avatar small @member.Tone">@member.Initials</span> }</div><span>@project.MemberCount members</span></div>
            </article>
        }
    </section>
}

@code {
    private static readonly string[] Filters = ["All projects", "Active", "Completed"];
    private List<ProjectSummary>? projects;
    private string activeFilter = "All projects";
    private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync() => projects = await ProjectService.GetProjectSummariesAsync();

    private IEnumerable<ProjectSummary> VisibleProjects => (projects ?? [])
        .Where(project => (activeFilter == "All projects" || project.Status == activeFilter || (activeFilter == "Active" && project.Status != "Complete"))
            && project.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private async Task AddProject()
    {
        await ProjectService.AddProjectAsync();
        projects = await ProjectService.GetProjectSummariesAsync();
    }
}
