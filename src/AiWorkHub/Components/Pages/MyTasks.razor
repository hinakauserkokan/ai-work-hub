@page "/my-tasks"
@using AiWorkHub.Models
@using AiWorkHub.Services
@inject WorkItemService WorkItemService

<PageTitle>My Tasks · AI Work Hub</PageTitle>

<div class="page-heading"><div><p class="eyebrow">WORKSPACE</p><h1>My tasks</h1><p class="page-subtitle">Plan your day and keep the important work visible.</p></div><button class="primary-button" @onclick="() => AddTask(WorkItemStatus.ToDo)"><span>＋</span> New task</button></div>

<section class="task-board-toolbar" aria-label="Task board controls"><div class="filter-tabs" role="tablist">@foreach (var filter in Filters) { <button class="filter-tab @(activeFilter == filter ? "active" : null)" @onclick="() => activeFilter = filter">@filter</button> }</div><p><strong>@OpenTaskCount</strong> open tasks</p></section>

@if (tasks is null)
{
    <p class="empty-column">Loading tasks…</p>
}
else
{
    <section class="kanban-board" aria-label="Task board">
        @foreach (var status in Columns)
        {
            <div class="board-column"><div class="board-column-heading"><div><span class="column-dot @status.ColumnTone()"></span><h2>@status.ColumnName()</h2><span>@TasksFor(status).Count()</span></div><button class="quiet-button" aria-label="Add task to @status.ColumnName()" @onclick="() => AddTask(status)">＋</button></div><div class="board-cards">
                @foreach (var task in TasksFor(status)) { <article class="board-card"><div class="board-card-title"><span class="priority-dot @task.Priority.CssClass()"></span><h3>@task.Title</h3><button class="quiet-button" aria-label="Task options">•••</button></div><p>@task.ProjectName</p><div class="board-card-footer"><span class="due-date @task.DueClass">@task.Due</span><div class="avatar small @task.Member.Tone">@task.Member.Initials</div></div><button class="move-task" @onclick="() => MoveTask(task)" aria-label="Move @task.Title to the next stage">Move to next stage →</button></article> }
                @if (!TasksFor(status).Any()) { <p class="empty-column">No tasks here yet.</p> }
            </div></div>
        }
    </section>
}

@code {
    private static readonly string[] Filters = ["Board", "List", "Completed"];
    private static readonly WorkItemStatus[] Columns = [WorkItemStatus.ToDo, WorkItemStatus.InProgress, WorkItemStatus.InReview];
    private List<WorkItemSummary>? tasks;
    private string activeFilter = "Board";

    protected override async Task OnInitializedAsync() => tasks = await WorkItemService.GetWorkItemSummariesAsync();

    private int OpenTaskCount => tasks?.Count ?? 0;
    private IEnumerable<WorkItemSummary> TasksFor(WorkItemStatus status) => (tasks ?? []).Where(task => task.Status == status);

    private async Task AddTask(WorkItemStatus status)
    {
        await WorkItemService.AddWorkItemAsync(status);
        tasks = await WorkItemService.GetWorkItemSummariesAsync();
    }

    private async Task MoveTask(WorkItemSummary task) => task.Status = await WorkItemService.MoveToNextStatusAsync(task.Id);
}
